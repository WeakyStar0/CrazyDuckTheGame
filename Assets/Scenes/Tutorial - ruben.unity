--- !u!114 &985794850
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 985794849}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 090f0faf2e217c149b0ea83a0f8e6a90, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - message: "Toue? Quem \xE9s tu? Como \xE9 que tens o meu n\xFAmero?"
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: "Espera... n\xE3o, n\xE3o \xE9 esse o problema aqui."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: "Tu est\xE1 a ver-me pela primeira vez, n\xE3o \xE9? Tu tamb\xE9m n\xE3o
      sabes o que se est\xE1 a passar."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: "N\xE3o, pois n\xE3o? \xC9 como eu. Eu sinto que tenho um prop\xF3sito,
      mas n\xE3o h\xE1 meio de me lembrar qual \xE9."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: "Eu nem me lembro do meu pr\xF3prio nome. Tu lembras-te do teu? "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: 'Mamoca? Que nome estranho. Os teus pais tiveram muita criatividade
      quando escolheram esse nome para ti. '
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: "Bem, eu n\xE3o quero ficar aqui sem nome, por isso deixa-me arranjar
      um tempor\xE1rio. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: Hmm... e que tal... Maminhas.
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: "\xC9 isso mesmo! Maminhas. T\xE1 decido!"
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: "Bem, Mamocas, eu n\xE3o fa\xE7o ideia o que se est\xE1 a passar, mas
      d\xE1 para perceber que estamos dentro de algum s\xEDtio e que algo de errado
      n\xE3o est\xE1 certo. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: "Acho que o melhor \xE9 continuarmos em frente e ver o que encontramos. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  - message: "Acho que o melhor \xE9 continuarmos em frente e ver o que encontramos. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
  triggerOnEnter: 1
  triggerOnInteract: 0
  interactKey: 101
  destroyAfterTrigger: 1
  requireTag: 1
  requiredTag: Player
