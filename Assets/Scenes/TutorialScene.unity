--- !u!114 &1115590724
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1115590722}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 090f0faf2e217c149b0ea83a0f8e6a90, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - message: Patos?!
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 60
    skipKey: 101
  - message: "Cuidado, eles parecem estar a patrulhar \xE0 procura de alguma coisa.
      Devem estar atr\xE1s de ti. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Se eles te veem, est\xE1s tramado. N\xE3o tens com que te defender. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Espera a\xED, o qu\xEA que est\xE1s a ver a\xED? "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: 'Toue?! De onde sacaste isso? '
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Isso \xE9 uma espada com uma pega em forma de pato.... Uma Espato!"
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Bem, agora j\xE1 podes lutar. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Usa o bot\xE3o esquerdo do rato, isso vai te permitir fazer um movimento
      de rota\xE7\xE3o com o teu bra\xE7o num eixo enquanto seguras a espada, e durante
      esse movimento os teus m\xFAsculos v\xE3o exercer uma for\xE7a que, com a velocidade
      do teu ataque, vai-te permitir danificar o inimigo."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 20
    typingSpeed: 0.025
    fontSize: 30
    skipKey: 101
  - message: "Agora \xE9s um homem armado, por isso... toca a bater neles. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  triggerOnEnter: 1
  triggerOnInteract: 0
  interactKey: 101
  destroyAfterTrigger: 1
  requireTag: 1
  requiredTag: Player
