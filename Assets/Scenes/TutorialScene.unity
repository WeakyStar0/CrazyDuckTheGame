  m_Script: {fileID: 11500000, guid: 090f0faf2e217c149b0ea83a0f8e6a90, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - message: "Toue? Quem \xE9s tu? Como \xE9 que tens o meu n\xFAmero?"
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 0
  - message: "Espera... n\xE3o, n\xE3o \xE9 esse o problema aqui."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 0
  - message: "Tu est\xE1 a ver-me pela primeira vez, n\xE3o \xE9? Tu tamb\xE9m n\xE3o
      sabes o que se est\xE1 a passar."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "\xC9 como eu. Eu sinto que tenho um prop\xF3sito, mas n\xE3o h\xE1
      meio de me lembrar qual \xE9."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Eu nem me lembro do meu pr\xF3prio nome. Tu lembras-te do teu? "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "N\xE3o, pois n\xE3o? Pois... A\xED \xE9 complicado. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Bem, eu n\xE3o fa\xE7o ideia o que se est\xE1 a passar, mas d\xE1 para
      perceber que estamos dentro de algum s\xEDtio e que algo de errado n\xE3o est\xE1
      certo. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Acho que o melhor \xE9 continuarmos em frente e ver o que encontramos. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  triggerOnEnter: 1
  triggerOnInteract: 0
  interactKey: 101
  destroyAfterTrigger: 1
  requireTag: 1
  requiredTag: Player
