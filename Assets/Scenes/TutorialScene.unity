--- !u!114 &1935298259
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1935298257}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 090f0faf2e217c149b0ea83a0f8e6a90, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - message: "Ena! Cuidado! Quase que ca\xEDamos."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: Quem foi o gajo que deixou este buraco aqui? Estas infraestruturas hoje
      em dia...
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Mas n\xE3o te preocupes, acho que arranjei uma solu\xE7\xE3o."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Eu tive aqui a ver as funcionalidades deste dispositivo e isto tem
      aqui muita informa\xE7\xE3o. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Por exemplo, tem aqui um tutorial que ensina a passar por este buraco
      atrav\xE9s daquelas plataformas e outros obst\xE1culos parecidos. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "\xC9 uma mec\xE2nica chamada saltar. Basicamente tens de ganhar balan\xE7o,
      depois dobrar um pouco as pernas e, por fim, impulsionar todo o teu corpo para
      cima, tirando ambos os p\xE9s do ch\xE3o. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 15
    typingSpeed: 0.025
    fontSize: 40
    skipKey: 101
  - message: "Durante uns momentos vais estar a aplicar uma for\xE7a que eleva o
      teu corpo para cima, e depois a gravidade voltar\xE1 a trazer-te para baixo. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Clica no espa\xE7o para conseguires saltar. Assim consegues passar
      para a plataforma sem cair no buraco. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  triggerOnEnter: 1
  triggerOnInteract: 0
  interactKey: 101
  destroyAfterTrigger: 1
  requireTag: 1
  requiredTag: Player
