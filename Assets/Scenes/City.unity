--- !u!114 &1379625528
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1379625526}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 090f0faf2e217c149b0ea83a0f8e6a90, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - message: 'Woah! '
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 1
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 0
  - message: 'Parece que estamos na cidade do tal Crazy Duck. '
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 0
  - message: "E acho que \xE9 uma cidade sob um regime de ditadura."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Estou a detetar v\xE1rias leituras como daquele artefacto que vimos
      no Hub. Se come\xE7ares a ouvir um som espec\xEDfico significa que est\xE1s
      pr\xF3ximo de um."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Em alternativa podes perguntar a algum dos habitantes da cidade, n\xE3o
      sei \xE9 se eles v\xE3o ser grande ajuda."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Mas tem cuidado, esta cidade est\xE1 cheia de guardas. Se eles te virem
      vais ter de lutar. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "E qualquer coisa, podes voltar ao laborat\xF3rio onde est\xE1vamos
      atrav\xE9s das tampas de esgoto. Elas funcionam como portais tamb\xE9m, confia."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Vamos l\xE1 ent\xE3o, j\xE1 estou a ficar todo encharcado. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  triggerOnEnter: 1
  triggerOnInteract: 0
  interactKey: 101
  destroyAfterTrigger: 1
  requireTag: 1
  requiredTag: Player
