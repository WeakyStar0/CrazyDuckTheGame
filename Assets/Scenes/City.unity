--- !u!114 &843471517
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 843471515}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 090f0faf2e217c149b0ea83a0f8e6a90, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - message: 'E agora? Estamos presos? '
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "A n\xE3o ser que..."
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 3
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: 'Eu consegui desbloquear uma nova habilidade para tu usares. '
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: 'Lembraste de como eu te ensinei a saltar? O Dr. Silverstein inventou
      umas botas com propulsores que permitem saltar duas vezes. '
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Como estamos na mente dele, consegues aceder a essas habilidades como
      se tivesses as pr\xF3prias botas. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  - message: "Quando saltares, volta a clicar no espa\xE7o antes de aterrares e vais
      conseguir saltar uma segunda vez permitindo-te alcan\xE7ar lugares antes imposs\xEDveis. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 10
    typingSpeed: 0.025
    fontSize: 40
    skipKey: 101
  - message: "Agora, olha \xE0 volta, podemos usar essa habilidade e fazer um novo
      caminho para passar para o outro lado. "
    soundEffect: {fileID: 0}
    characterSprite: {fileID: 21300000, guid: e3d46447b20031b46a493793f2894113, type: 3}
    characterName: ???
    showCharacter: 1
    freezePlayer: 1
    autoAdvanceDelay: 5
    typingSpeed: 0.025
    fontSize: 50
    skipKey: 101
  triggerOnEnter: 1
  triggerOnInteract: 0
  interactKey: 101
  destroyAfterTrigger: 1
  requireTag: 1
  requiredTag: Player
